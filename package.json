{
  "name": "pi-streaming-voice",
  "version": "0.1.0",
  "description": "Push-to-talk (hold Space) streaming voice input for pi, using Deepgram Nova-3",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "speech-to-text",
    "deepgram"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --test test/*.test.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
