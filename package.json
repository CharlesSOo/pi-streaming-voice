{
  "name": "pi-streaming-voice",
  "version": "0.3.0",
  "description": "Push-to-talk streaming voice input for pi, using Deepgram Nova-3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlesSOo/pi-streaming-voice.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "voice",
    "dictation",
    "speech-to-text",
    "deepgram"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "npm run check && node --experimental-test-module-mocks --test --test-timeout=20000 test/*.test.ts",
    "bridge:install": "node scripts/bridge-install.ts",
    "bridge:uninstall": "node scripts/bridge-uninstall.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "dependencies": {
    "@handy-computer/recorder": "0.2.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
